# Database
MONGODB_URI=mongodb://localhost:27017/intervyo

# JWT
JWT_SECRET=
demo-secret-key-for-testing-only

# Server
PORT=5000
NODE_ENV=development

# Frontend URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OAuth (Optional - Leave empty for demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments (Razorpay test keys; add real keys only in production secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Services (Optional - Leave empty for demo mode)
GROQ_API_KEY=
OPENAI_API_KEY=

# Email service (required for OTP and contact confirmation emails)
# Deploy santanu-atta03/otp-mail-service, then provide its /api/send-otp URL
# and the matching bearer token configured by that service.
OTP_MAIL_SERVICE_URL=
OTP_MAIL_SERVICE_TOKEN=

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
